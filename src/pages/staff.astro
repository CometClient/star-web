---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/site/Header.astro";
import FloatingFooter from "../components/site/FloatingFooter.astro";
import { listStaff } from "../lib/db";
import { craftyFullBody } from "../lib/crafty";

const staff = await listStaff(true);

const tiers = [
  { key: "owner", label: "Owner" },
  { key: "manager", label: "Manager" },
  { key: "developer", label: "Developer" },
  { key: "admin", label: "Admin" },
  { key: "support", label: "Support" },
  { key: "team", label: "Team" },
] as const;

function membersInTier(tier: string) {
  return staff.filter((m) => m.role_tier === tier);
}
---

<SiteLayout title="Staff — Comet Client">
  <Header />
  <main class="flex min-h-screen flex-col">
    <div class="hero-concept hero-concept--short relative h-72 sm:h-80">
      <div class="hero-concept__bg" aria-hidden="true"></div>
      <div class="relative z-[1] flex h-full items-end">
        <div class="mx-auto w-full max-w-5xl px-4 pb-10 sm:px-6">
          <div class="tier-header inline-block px-6 py-5">
            <p class="font-pixel text-[10px] tracking-[0.2em] text-white/40">Our</p>
            <h1 class="font-pixel mt-1 text-4xl text-gradient-gold sm:text-5xl">Staff</h1>
            <p class="mt-2 text-sm text-white/45">The people who make it all possible.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="page-body flex-1 py-16">
      <div class="mx-auto max-w-5xl space-y-16 px-4 sm:px-6">
        {staff.length === 0 ? (
          <p class="text-white/40">No staff members listed yet.</p>
        ) : (
          tiers.map((tier) => {
            const members = membersInTier(tier.key);
            if (members.length === 0) return null;
            return (
              <section>
                <div class="mb-6 flex items-baseline gap-3 border-b border-white/5 pb-4">
                  <h2 class="font-pixel text-2xl text-gradient-gold">{tier.label}</h2>
                  <span class="font-mono text-[9px] uppercase tracking-widest text-white/30">
                    {members.length} user{members.length === 1 ? "" : "s"}
                  </span>
                </div>
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {members.map((m, i) => {
                    const featured = tier.key === "owner" || (tier.key === "manager" && i === 0);
                    const username = m.mc_username || "Steve";
                    return (
                      <article class={`staff-card staff-card--${tier.key} ${featured ? "staff-card--featured" : ""}`}>
                        <div class="staff-card__render">
                          <img
                            src={craftyFullBody(username)}
                            alt=""
                            loading="lazy"
                            width="200"
                            height="320"
                          />
                        </div>
                        <div class="staff-card__body">
                          <h3 class="font-pixel text-lg text-gradient-gold">{m.display_name.toUpperCase()}</h3>
                          {m.mc_username && (
                            <p class="staff-card__handle">
                              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                              {m.mc_username}
                            </p>
                          )}
                          <div class="staff-card__roles">
                            <span class="staff-card__role">{tier.label}</span>
                            <span class="staff-card__role">{m.role}</span>
                          </div>
                          {m.bio && <p class="staff-card__bio">{m.bio}</p>}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            );
          })
        )}
      </div>
    </div>

    <FloatingFooter />
  </main>
</SiteLayout>
