---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/site/Header.astro";
import FloatingFooter from "../../components/site/FloatingFooter.astro";
import { listNews } from "../../lib/db";
import NewsCard from "../../components/news/NewsCard.astro";

const posts = await listNews(true);
const pinned = posts.filter((p) => p.pinned);
const regular = posts.filter((p) => !p.pinned);
---

<SiteLayout title="News — Comet Client">
  <Header />
  <main class="flex min-h-screen flex-col">
    <div class="hero-concept--short relative min-h-[16rem] sm:min-h-[18rem]">
      <div class="absolute inset-0 flex items-end">
        <div class="mx-auto w-full max-w-5xl px-4 pb-10 pt-28 sm:px-6">
          <div class="tier-header inline-block px-6 py-5">
            <p class="font-pixel text-[10px] tracking-[0.2em] text-white/40">Updates</p>
            <h1 class="font-pixel mt-1 text-4xl text-gradient-gold sm:text-5xl">News</h1>
            <p class="mt-2 text-sm text-white/45">From the Comet team.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="page-body flex-1 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        {posts.length === 0 ? (
          <div class="tier-header px-6 py-8 text-center">
            <p class="font-pixel text-white/50">No posts yet</p>
            <p class="mt-2 text-sm text-white/30">Check back soon for updates.</p>
          </div>
        ) : (
          <div class="space-y-14">
            {pinned.length > 0 && (
              <section>
                <div class="mb-5 flex items-baseline gap-3 border-b border-white/5 pb-3">
                  <h2 class="font-pixel text-lg text-gradient-pink">Pinned</h2>
                  <span class="font-mono text-[9px] uppercase tracking-widest text-white/30">
                    {pinned.length} post{pinned.length === 1 ? "" : "s"}
                  </span>
                </div>
                <div class="grid gap-5">
                  {pinned.map((post) => (
                    <NewsCard post={post} featured />
                  ))}
                </div>
              </section>
            )}

            {regular.length > 0 && (
              <section>
                {pinned.length > 0 && (
                  <div class="mb-5 flex items-baseline gap-3 border-b border-white/5 pb-3">
                    <h2 class="font-pixel text-lg text-white/80">All posts</h2>
                    <span class="font-mono text-[9px] uppercase tracking-widest text-white/30">
                      {regular.length} post{regular.length === 1 ? "" : "s"}
                    </span>
                  </div>
                )}
                <div class="grid gap-4 sm:grid-cols-2">
                  {regular.map((post) => (
                    <NewsCard post={post} />
                  ))}
                </div>
              </section>
            )}
          </div>
        )}
      </div>
    </div>

    <FloatingFooter />
  </main>
</SiteLayout>
