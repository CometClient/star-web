---
import "../styles/global.css";
import DownloadSheet from "../components/site/DownloadSheet.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Comet Client",
  description = "A modern Fabric Minecraft launcher with curated mods and a native UI.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/comet-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <DownloadSheet />
    <script>
      import { initSitePlatform } from "../scripts/download";
      initSitePlatform();
    </script>
  </body>
</html>
