---
import "../styles/global.css";
import DownloadSheet from "../components/site/DownloadSheet.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Comet Client",
  description = "A modern Fabric Minecraft launcher with curated mods and a native UI.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <DownloadSheet />
    <script>
      import { initSitePlatform } from "../scripts/download";
      initSitePlatform();
    </script>
    <script>
      // Soft reveal for sections as they scroll in. Classes are only added
      // from JS, so no-JS visitors (and reduced-motion users) see everything.
      if (
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
        "IntersectionObserver" in window
      ) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("reveal-in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );
        const sections = document.querySelectorAll("main section:not(.hero-concept)");
        sections.forEach((section) => {
          section.classList.add("reveal-init");
          io.observe(section);
        });
        // Failsafe: never leave content hidden (slow IO, anchor jumps, etc).
        setTimeout(() => {
          sections.forEach((section) => section.classList.add("reveal-in"));
          io.disconnect();
        }, 1800);
      }
    </script>
  </body>
</html>
