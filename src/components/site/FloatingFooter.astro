---
const year = new Date().getFullYear();

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#dive-in", label: "Dive In" },
  { href: "/news", label: "News" },
  { href: "/staff", label: "Staff" },
];
---

<footer class="site-footer page-body" aria-label="Site footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <div class="flex items-center gap-3">
        <span class="brand__planet h-8 w-8">
          <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M245.11,60.68c-7.65-13.19-27.85-16.16-58.5-8.66A96,96,0,0,0,32.81,140.3C5.09,169,5.49,186,10.9,195.32,16,204.16,26.64,208,40.64,208a124.11,124.11,0,0,0,28.79-4,96,96,0,0,0,153.78-88.25c12.51-13,20.83-25.35,23.66-35.92C248.83,72.51,248.24,66.07,245.11,60.68Zm-13.69,15c-6.11,22.78-48.65,57.31-87.52,79.64-67.81,39-113.62,41.52-119.16,32-1.46-2.51-.65-7.24,2.22-13a80.06,80.06,0,0,1,10.28-15.05,95.53,95.53,0,0,0,6.23,14.18,4,4,0,0,0,4,2.12,122.14,122.14,0,0,0,16.95-3.32c21.23-5.55,46.63-16.48,71.52-30.78s47-30.66,62.45-46.15A122.74,122.74,0,0,0,209.7,82.45a4,4,0,0,0,.17-4.52,96.26,96.26,0,0,0-9.1-12.46c14.21-2.35,27.37-2.17,30.5,3.24C232.19,70.28,232.24,72.63,231.42,75.69Z"/></svg>
        </span>
        <div>
          <p class="font-pixel text-lg text-white">comet</p>
          <p class="mt-1 text-xs text-white/35">The fastest way to play.</p>
        </div>
      </div>
      <p class="site-footer__tagline">
        Crafted by and for the community. No bloat, no ads, no tracking. We believe in a fast, stable, and reliable experience for all users. That's what it's all about.
      </p>
    </div>

    <nav class="site-footer__nav flex flex-col items-end" aria-label="Footer">
      <div class="flex items-center gap-x-6">
        {links.map((link) => (
          <a href={link.href} class="site-footer__link">{link.label}</a>
        ))}
        <button type="button" class="site-footer__link site-footer__link--button" data-download-sheet-open>
          Beta Access
        </button>
      </div>
      <a href="https://www.thegreenwebfoundation.org/green-web-check/?url=cometclient.dev" target="_blank" rel="noopener noreferrer" class="mt-6 block">
        <img
          src="https://app.greenweb.org/api/v3/greencheckimage/cometclient.dev?nocache=true"
          alt="This website runs on green hosting - verified by thegreenwebfoundation.org"
          width="140"
          height="67"
          class="opacity-50 transition hover:opacity-90"
        />
      </a>
    </nav>

    <div class="site-footer__legal">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/tos" class="text-[11px] text-white/30 transition hover:text-white/55">Terms</a>
        <a href="/privacy" class="text-[11px] text-white/30 transition hover:text-white/55">Privacy</a>
        <a href="/branding" class="text-[11px] text-white/30 transition hover:text-white/55">Branding</a>
      </div>
      <p class="font-pixel text-[9px] uppercase tracking-[0.18em] text-white/30">Copyright © {year} Comet Client</p>
      <p class="text-[11px] text-white/30">Not affiliated with Mojang or Microsoft.</p>
    </div>
  </div>
</footer>