---
const modGroups = [
  {
    label: "Performance",
    color: "pink",
    mods: ["Polaris (Entity Culling)", "Sodium/Optifine", "LazyDFU", "Minecraft Patcher"],
  },
  {
    label: "Visuals",
    color: "ocean",
    mods: ["Iris", "Comet Zoom", "FPS and Keystrokes", "Enhanced Loading"],
  },
  {
    label: "Quality of life",
    color: "gold",
    mods: ["Mod Menu", "Freelook", "BetterF3", "Freecam", "Chat Heads"],
  },
];
---

<section id="mods" class="mods-section page-body border-y border-[hsl(228,10%,11%)] py-20 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-pixel text-[10px] uppercase tracking-[0.22em] text-white/30">Shipped with Comet</p>
        <h2 class="font-pixel mt-2 text-3xl text-gradient-gold sm:text-4xl">Built-in mods</h2>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/45">
          Curated, version-locked, and configured out of the box. Toggle anything from one panel.
        </p>
      </div>
      <div class="mods-section__stat glass inline-flex shrink-0 items-center gap-3 rounded-lg px-4 py-3">
        <span class="font-pixel text-2xl text-pink-200">15+</span>
        <span class="max-w-[8rem] text-xs leading-snug text-white/40">mods pre-installed on first launch</span>
      </div>
    </div>

    <div class="mods-grid">
      {modGroups.map((group) => (
        <article class={`mods-group mods-group--${group.color}`}>
          <header class="mods-group__head">
            <span class="mods-group__dot" aria-hidden="true"></span>
            <h3 class="font-pixel text-[11px] tracking-[0.14em] text-white/70">{group.label}</h3>
          </header>
          <ul class="mods-group__list">
            {group.mods.map((mod) => (
              <li class="mods-group__item font-mono">{mod}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
