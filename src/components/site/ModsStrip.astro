---
const sources = [
  {
    label: "Modrinth",
    color: "emerald",
    desc: "Search the catalog and install Fabric mods in one click — version-matched to your instance.",
  },
  {
    label: "Modpacks",
    color: "gold",
    desc: "Import all your mods with a single click, and Comet handles the rest for you. No extra effort required.",
  },
  {
    label: "Your desktop",
    color: "ocean",
    desc: "Drag a .jar from Finder or Explorer. Comet validates, resolves deps, and loads on next launch.",
  },
];
---

<section id="mods" class="mods-section page-body border-y border-[hsl(228,10%,11%)] py-20 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mods-showcase grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
      <div>
        <p class="font-pixel text-[10px] uppercase tracking-[0.22em] text-white/30">Mod manager</p>
        <h2 class="font-pixel mt-2 text-3xl text-gradient-gold sm:text-4xl">Install any mod</h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-white/45">
          Modrinth, Modpacks, or a file on your desktop — Comet handles compatibility,
          dependencies, and loading without extra tools.
        </p>

        <ul class="mt-8 space-y-4">
          {sources.map((source) => (
            <li class={`mod-source mod-source--${source.color}`}>
              <span class="mod-source__dot" aria-hidden="true"></span>
              <div>
                <h3 class="font-pixel text-sm tracking-[0.12em] text-white/80">{source.label}</h3>
                <p class="mt-1 text-xs leading-relaxed text-white/42">{source.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="mod-showcase-visual">
        <div class="mod-showcase__glow" aria-hidden="true"></div>
        <figure class="mod-showcase__frame">
          <div class="mod-showcase__chrome" aria-hidden="true">
            <span class="mod-showcase__dot mod-showcase__dot--red"></span>
            <span class="mod-showcase__dot mod-showcase__dot--yellow"></span>
            <span class="mod-showcase__dot mod-showcase__dot--green"></span>
            <span class="mod-showcase__title">comet · mods</span>
          </div>
          <img
            src="/modshows.png"
            alt="Comet mod installer — Modrinth, Modpacks, and local files"
            width="1212"
            height="832"
            class="mod-showcase__img"
            loading="lazy"
          />
          <div class="mod-showcase__overlay" aria-hidden="true">
            <span class="mod-showcase__badge font-pixel">Modrinth</span>
            <span class="mod-showcase__badge font-pixel">Modpacks</span>
            <span class="mod-showcase__badge font-pixel">Local .jar</span>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>
