---
---

<div id="download-sheet-backdrop" class="beta-modal-backdrop" aria-hidden="true"></div>

<div
  id="download-sheet"
  class="beta-modal"
  role="dialog"
  aria-label="Closed beta"
  aria-modal="true"
>
  <button
    type="button"
    class="beta-modal__close"
    data-download-sheet-close
    aria-label="Close"
  >×</button>

  <div class="beta-modal__icon">
    <img src="/comet-logo.png" alt="" width="48" height="48" />
  </div>

  <p class="font-pixel text-[10px] tracking-[0.22em] text-pink-200/80">Closed beta</p>
  <h2 class="font-pixel mt-2 text-xl text-white sm:text-2xl">Comet isn't public yet</h2>

  <p class="beta-modal__body">
    We're inviting testers in waves through Discord. Grab an invite token there — public downloads open once we hit stability targets.
  </p>

  <a href="#" class="btn-pixel btn-pixel--pink beta-modal__cta">
    Get beta access on Discord
  </a>

  <p class="beta-modal__hint font-mono text-[10px] uppercase tracking-widest text-white/28">
    No public builds · Invite only
  </p>
</div>
