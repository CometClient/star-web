<section id="features" class="page-body py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="tier-header mb-14 inline-block px-6 py-5">
      <p class="font-pixel text-[10px] tracking-[0.25em] text-white/40">Features</p>
      <h2 class="font-pixel mt-2 text-3xl text-gradient-gold sm:text-4xl">What Comet ships</h2>
      <p class="mt-3 max-w-md text-sm text-white/45">Accurate today — no vaporware.</p>
      <div class="xp-bar mt-4" aria-hidden="true"></div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class={`feature-card-v2 feature-card-v2--${f.accent}`}>
          <div class="feature-card-v2__head">
            <span class="feature-card-v2__icon">
              <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d={f.icon} /></svg>
            </span>
            <span class="feature-card-v2__num font-mono">{f.num}</span>
          </div>
          <p class="feature-card-v2__tag font-mono">{f.tag}</p>
          <h3 class="feature-card-v2__title font-pixel">{f.title}</h3>
          <p class="feature-card-v2__body">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
