---
---

<section id="download" class="relative py-28">
  <div class="pointer-events-none absolute inset-0 concept-bg opacity-50" aria-hidden="true" />

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6">
    <img
      src="/comet-logo.png"
      alt=""
      width="72"
      height="72"
      class="mx-auto mb-8 h-18 w-18 drop-shadow-[0_0_40px_rgba(253,209,244,0.4)]"
    />

    <h2 class="font-minecraft mb-4 text-4xl text-white sm:text-5xl">
      Ready to <span class="text-gradient">launch</span>?
    </h2>
    <p class="mb-10 text-lg text-white/55">
      No account required. No card. Download Comet and join the next generation of Minecraft players.
    </p>

    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="#" class="btn-gradient inline-flex w-full items-center justify-center gap-2 rounded-xl px-10 py-4 text-lg sm:w-auto">
        Download for Windows
      </a>
      <a href="#" class="btn-outline inline-flex w-full items-center justify-center rounded-xl px-10 py-4 text-lg sm:w-auto">
        macOS & Linux soon
      </a>
    </div>

    <p class="mt-8 font-mono text-xs text-white/30">
      Fabric 1.21.4 · Requires Java 21 · Free forever
    </p>
  </div>
</section>

<style>
  .font-minecraft {
    font-family: 'Fastelar', 'Inter', sans-serif;
  }
</style>
