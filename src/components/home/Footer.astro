---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6">
    <div class="flex items-center gap-2.5">
      <img src="/comet-logo.png" alt="" width="28" height="28" class="h-7 w-7 opacity-80" />
      <span class="font-minecraft text-lg text-white/80">comet</span>
    </div>

    <p class="text-sm text-white/35">
      © {year} Comet Client. Not affiliated with Mojang or Microsoft.
    </p>
  </div>
</footer>

<style>
  .font-minecraft {
    font-family: 'Fastelar', 'Inter', sans-serif;
  }
</style>
