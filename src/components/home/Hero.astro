---
---

<section class="concept-bg relative min-h-screen overflow-hidden">
  <div class="mc-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true" />

  <div class="relative mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-4 pb-24 pt-32 sm:px-6">
    <div id="announcement" class="fade-up mb-8 hidden max-w-xl">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full glass-panel px-4 py-2 text-sm text-white/80 transition hover:border-pink-300/30"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
        <span id="announcement-text"></span>
        <span class="text-pink-200/80">→</span>
      </a>
    </div>

    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="fade-up" style="animation-delay: 0.1s">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.25em] text-emerald-400/90">
          Fabric · 1.21.4 · Free
        </p>

        <h1 class="font-minecraft mb-6 text-5xl leading-[0.95] tracking-wide sm:text-6xl lg:text-7xl">
          <span class="text-gradient">Play Minecraft</span>
          <br />
          <span class="text-white">the way it should feel.</span>
        </h1>

        <p class="mb-8 max-w-lg text-lg leading-relaxed text-white/65">
          Comet is a Fabric launcher with boosted frames, hand-picked mods, and a UI
          built for 2026 — layered over the worlds you already love.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="#download" class="btn-gradient inline-flex items-center gap-2 rounded-xl px-7 py-3.5 text-base">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download free
          </a>
          <a href="#features" class="btn-outline rounded-xl px-7 py-3.5 text-base">
            See features
          </a>
        </div>

        <dl class="mt-12 grid grid-cols-3 gap-4 border-t border-white/10 pt-8">
          <div>
            <dt class="font-minecraft text-2xl text-pink-200">2×</dt>
            <dd class="mt-1 text-xs uppercase tracking-wider text-white/45">Avg FPS boost</dd>
          </div>
          <div>
            <dt class="font-minecraft text-2xl text-emerald-300">15+</dt>
            <dd class="mt-1 text-xs uppercase tracking-wider text-white/45">Curated mods</dd>
          </div>
          <div>
            <dt class="font-minecraft text-2xl text-sky-300">0</dt>
            <dd class="mt-1 text-xs uppercase tracking-wider text-white/45">Setup required</dd>
          </div>
        </dl>
      </div>

      <div class="fade-up float relative mx-auto w-full max-w-md lg:max-w-none" style="animation-delay: 0.25s">
        <div class="absolute -inset-8 rounded-full bg-gradient-to-br from-pink-400/20 via-transparent to-emerald-400/15 blur-3xl" aria-hidden="true" />

        <div class="block-corner glass-panel relative overflow-hidden rounded-2xl p-1">
          <div class="flex items-center gap-2 rounded-t-xl bg-black/40 px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
            <span class="ml-2 font-mono text-xs text-white/40">comet · fabric 1.21.4</span>
          </div>
          <img
            src="/launcher-preview.jpg"
            alt="Comet launcher preview"
            width="800"
            height="500"
            class="w-full rounded-b-xl object-cover"
            loading="eager"
          />

          <div class="absolute bottom-6 left-6 rounded-xl glass-panel px-4 py-2.5">
            <p class="font-mono text-xs text-white/50">FPS</p>
            <p class="font-minecraft text-2xl text-emerald-300">144</p>
          </div>
          <div class="absolute bottom-6 right-6 rounded-xl glass-panel px-4 py-2.5">
            <p class="font-mono text-xs text-white/50">Mods</p>
            <p class="font-minecraft text-2xl text-pink-200">18 loaded</p>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-center">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/30">Scroll</p>
      <div class="mx-auto mt-2 h-8 w-5 rounded-full border border-white/15 p-1">
        <div class="mx-auto h-1.5 w-1 rounded-full bg-pink-300/60 animate-bounce"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .font-minecraft {
    font-family: 'Fastelar', 'Inter', sans-serif;
  }
</style>

<script>
  fetch('/api/launcher/announcements')
    .then((r) => r.json())
    .then((data) => {
      const item = Array.isArray(data) ? data.find((a) => a.is_active) ?? data[0] : null;
      if (!item?.announcement) return;
      const banner = document.getElementById('announcement');
      const text = document.getElementById('announcement-text');
      if (!banner || !text) return;
      text.textContent = item.announcement;
      banner.classList.remove('hidden');
      const link = banner.querySelector('a');
      if (link && item.redirect_url) link.href = item.redirect_url;
    })
    .catch(() => {});
</script>
