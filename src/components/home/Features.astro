---
const features = [
  {
    icon: "⚡",
    title: "Boosted performance",
    desc: "Sodium and Iris baked in. Frames more than double on most setups with stable lows.",
    accent: "from-pink-400/20 to-transparent",
  },
  {
    icon: "🧩",
    title: "Mods, curated",
    desc: "15+ Fabric mods pre-installed — performance, QoL, and visuals. Zero config on first launch.",
    accent: "from-emerald-400/20 to-transparent",
  },
  {
    icon: "🌍",
    title: "Every version",
    desc: "Switch between 1.20.x, 1.21.x, and snapshots. Each ships with the right mod pack.",
    accent: "from-sky-400/20 to-transparent",
  },
  {
    icon: "🎨",
    title: "Free cosmetics",
    desc: "Capes, cloaks, and seasonal drops crafted by our team. Stand out on every server.",
    accent: "from-pink-400/20 to-transparent",
  },
  {
    icon: "🔧",
    title: "Your mods too",
    desc: "Drop any Fabric jar into the launcher. We validate, resolve deps, and load cleanly.",
    accent: "from-emerald-400/20 to-transparent",
  },
  {
    icon: "✨",
    title: "Native UI",
    desc: "A launcher that feels like a real app — dark, fast, and built for long sessions.",
    accent: "from-sky-400/20 to-transparent",
  },
];
---

<section id="features" class="relative py-28">
  <div class="pointer-events-none absolute inset-0 concept-bg-soft opacity-30" aria-hidden="true" />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-pink-300/80">Why Comet</p>
      <h2 class="font-minecraft text-4xl tracking-wide text-white sm:text-5xl">
        Built for the <span class="text-gradient">overworld</span>
      </h2>
      <p class="mt-4 text-lg text-white/55">
        Everything you need to jump in — nothing you don't. Fabric-first, performance-obsessed.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class="block-corner glass-panel group rounded-2xl p-6 transition hover:border-pink-300/20">
          <div class={`mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${f.accent} text-2xl`}>
            {f.icon}
          </div>
          <h3 class="font-minecraft mb-2 text-xl text-white">{f.title}</h3>
          <p class="text-sm leading-relaxed text-white/55">{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .font-minecraft {
    font-family: 'Fastelar', 'Inter', sans-serif;
  }
</style>
