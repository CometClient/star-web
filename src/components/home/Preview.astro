---
---

<section id="preview" class="relative py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-sky-300/80">In-game</p>
        <h2 class="font-minecraft mb-6 text-4xl leading-tight text-white sm:text-5xl">
          Worlds that breathe again
        </h2>
        <p class="mb-8 text-lg leading-relaxed text-white/55">
          Shaders, smooth lighting, and optimized chunk loading — the birch forests and
          mountain vistas from concept art, rendered at the frame rate you deserve.
        </p>

        <ul class="space-y-4">
          {[
            "Iris shader pipeline with sensible defaults",
            "Dynamic lighting without the stutter",
            "Chunk loading tuned for exploration",
          ].map((item) => (
            <li class="flex items-start gap-3 text-white/70">
              <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded bg-emerald-500/20 text-xs text-emerald-300">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="relative">
        <div class="absolute -inset-6 rounded-3xl bg-gradient-to-tr from-emerald-500/10 via-transparent to-pink-500/10 blur-2xl" aria-hidden="true" />
        <div class="block-corner relative overflow-hidden rounded-2xl border border-white/10">
          <img
            src="/hero-birch-forest.jpg"
            alt="Minecraft-style forest landscape"
            width="960"
            height="640"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[hsl(220,18%,4%)] via-transparent to-pink-500/10" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .font-minecraft {
    font-family: 'Fastelar', 'Inter', sans-serif;
  }

  #preview .relative:last-child {
    position: relative;
  }
</style>
