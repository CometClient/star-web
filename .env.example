# --- Remote DB (Cloudflare D1 worker) ---
# Deploy workers/db first, then set these on the frontend host.
# Leave unset for local SQLite (db/data/comet.db).

# DB worker URL (no trailing slash)
DB_API_URL=https://comet-db.YOUR_SUBDOMAIN.workers.dev

# Same secret as `wrangler secret put DB_API_SECRET` on the DB worker
DB_API_SECRET=generate-a-long-random-string

# Optional: public URL for browser-side launcher fetches (defaults to DB_API_URL)
PUBLIC_DB_API_URL=https://comet-db.YOUR_SUBDOMAIN.workers.dev

# --- Staff CMS (/local/staff) ---
STAFF_EMAIL=ray.dev@cometclient.dev
STAFF_PASSWORD=change-me
SESSION_SECRET=change-me-in-production

# Local SQLite path (when DB_API_URL is unset)
# DATABASE_PATH=./db/data/comet.db
